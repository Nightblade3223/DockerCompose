# Main path for all ARR apps:
ARRPATH=/media/Arr/  # in Windows it will be sth like ARRPATH=C:\myfolder\Arr\
NASDRIVE_1=/nas_share/Arr/
# Base path for non-ARR applications (keep the trailing slash):
NASDRIVE_2=/nas_share/Other/
CACHE=/nas_share/cache/
# Global Variables
PUID=1000
PGID=1000
TZ=Australia/Brisbane
